# Required for local development if you want to use the built-in API route
CLAUDE_API_KEY=your-claude-api-key

# Optional: use this when building the static site to point the editor page at a Supabase function
PUBLIC_EDITOR_API_URL=https://<project>.functions.supabase.co/editor

# In Vercel, set CLAUDE_API_KEY as a secret and leave PUBLIC_EDITOR_API_URL unset
