---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** When true (e.g. homepage hero), skip the nav-height top padding so hero can sit under the nav. */
  fullBleed?: boolean;
}

const { title, description, image, fullBleed = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    {/* Runs before first paint so a stored light choice never flashes dark.
        Inline and synchronous on purpose, deferring it reintroduces the flash. */}
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') {
              document.documentElement.dataset.theme = stored;
            }
          } catch (e) {
            /* private mode / storage disabled, fall back to the media query */
          }
        };
        apply();
        // ClientRouter swaps the whole document on navigation, which drops the
        // data-theme attribute from <html>. astro:after-swap runs before the
        // new page paints, so re-applying here avoids a flash of the wrong theme.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class={fullBleed ? '' : 'main-padded'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
  }
  .skip-link:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  /* Clears the 4rem fixed nav with breathing room, without stranding the
     content halfway down the viewport. */
  .main-padded {
    padding-top: 5.5rem;
  }
  @media (max-width: 640px) {
    .main-padded {
      padding-top: 5rem;
    }
  }
</style>
