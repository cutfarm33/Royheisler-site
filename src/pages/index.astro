---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Roy Heisler" description="Director, DP, Editor, Photographer, Developer." fullBleed>
  <section class="min-h-screen flex items-center">
    <div class="max-w-[1400px] w-full mx-auto px-6 md:px-12">
      <p class="label" style="color: var(--fg-muted); margin-bottom: 1.5rem;">Coming soon — home / news feed</p>
      <h1 class="display-xl">Roy<span style="color: var(--fg-dim);">.</span></h1>
      <p class="caption" style="margin-top: 1.5rem; max-width: 48ch;">
        Step 4 wires the featured project hero and news feed.
      </p>
    </div>
  </section>
</BaseLayout>
