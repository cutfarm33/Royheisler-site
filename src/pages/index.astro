---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Roy Heisler — scaffold ready</title>
  </head>
  <body style="padding: 3rem;">
    <p style="font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-muted); margin: 0 0 1rem;">
      Step 1 · scaffold ready
    </p>
    <h1 style="font-family: var(--font-display); font-weight: 500; font-size: clamp(48px, 9vw, 96px); letter-spacing: -0.035em; line-height: 0.95; margin: 0 0 2rem;">
      Roy<span style="color: var(--fg-dim);">.</span>
    </h1>
    <p style="max-width: 60ch; color: var(--fg-muted); margin: 0 0 2rem;">
      Astro 6 · Tailwind 4 · MDX · Geist Variable · TS strict. Step 2 replaces this page with a proper BaseLayout and Nav/Footer.
    </p>
    <p style="font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; margin: 0;">
      <span style="color: var(--accent);">reel</span>
      <span style="color: var(--fg-dim); margin: 0 0.5rem;">·</span>
      <span class="text-white/60">tailwind utility test</span>
    </p>
  </body>
</html>
