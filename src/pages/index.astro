---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterPills from '../components/FilterPills.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { getProjectsForIndex } from '../lib/projects';

const projects = await getProjectsForIndex();
---

<BaseLayout
  title="Video"
  description="Selected film and commercial work."
>
  <section class="max-w-[1400px] mx-auto px-6 md:px-12">
    <header class="work-header">
      <h1 class="display-l">Video<span style="color: var(--fg-dim);">.</span></h1>
      <FilterPills />
    </header>

    <div class="work-grid" data-filter="all">
      {projects.map((p) => <ProjectTile project={p} />)}
    </div>

    <p class="work-empty label" aria-live="polite">No projects match this filter.</p>
  </section>
</BaseLayout>

<style>
  .work-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
    }
  }
  /* Filter via data-attribute on the grid, set by FilterPills.astro's script.
     The tiles are rendered by ProjectTile.astro and carry *its* scope hash, so
     the child half of these selectors must be :global() — otherwise Astro scopes
     it to this page's hash and it matches nothing. */
  .work-grid[data-filter="film"] > :global(:not([data-discipline="film"])) { display: none; }
  .work-grid[data-filter="photo"] > :global(:not([data-discipline="photo"])) { display: none; }
  .work-grid[data-filter="graphics"] > :global(:not([data-discipline="graphics"])) { display: none; }
  .work-grid[data-filter="code"] > :global(:not([data-discipline="code"])) { display: none; }

  .work-empty {
    display: none;
    margin-top: 3rem;
    color: var(--fg-muted);
  }
  /* The empty state is toggled by the script below, which measures whether any
     tile is still visible after the filter applies. */
</style>

<script>
  const syncEmpty = () => {
    const grid = document.querySelector<HTMLElement>('.work-grid');
    const empty = document.querySelector<HTMLElement>('.work-empty');
    if (!grid || !empty) return;
    const visible = [...grid.children].some(
      (c) => window.getComputedStyle(c as Element).display !== 'none',
    );
    empty.style.display = visible ? 'none' : 'block';
  };
  const mo = new MutationObserver(syncEmpty);
  const bind = () => {
    const grid = document.querySelector<HTMLElement>('.work-grid');
    if (!grid) return;
    mo.disconnect();
    mo.observe(grid, { attributes: true, attributeFilter: ['data-filter'] });
    syncEmpty();
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
