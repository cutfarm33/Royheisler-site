---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import NewsItem from '../components/NewsItem.astro';
import {
  getAllProjects,
  getFeaturedProject,
  disciplineLabel,
  primaryDisciplineLabel,
} from '../lib/projects';

const featured = await getFeaturedProject();
const projects = await getAllProjects();

const heroMonth = featured.data.publishedAt
  .toLocaleString('en-US', { month: 'short' })
  .toUpperCase();
const heroYear = featured.data.publishedAt.getFullYear();
---

<BaseLayout
  title="Roy Heisler"
  description="Director, DP, Editor, Photographer, Developer. Selected work for agencies and production companies."
  fullBleed
>
  <section class="hero pt-28 md:pt-32">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <p class="label hero-label">Latest — {heroMonth} {heroYear}</p>
      <h1 class="display-xl hero-title">
        {featured.data.title}<span style="color: var(--fg-dim);">.</span>
      </h1>
    </div>

    <div class="max-w-[1400px] mx-auto px-6 md:px-12 mt-8">
      {featured.data.heroVideo ? (
        <VideoEmbed
          url={featured.data.heroVideo.url}
          mode="loop-muted"
          poster={featured.data.heroVideo.poster}
          title={featured.data.title}
        />
      ) : featured.data.heroImage ? (
        <img src={featured.data.heroImage.src} alt="" class="hero-still" />
      ) : null}
    </div>

    <div class="max-w-[1400px] mx-auto px-6 md:px-12 mt-4 hero-meta">
      <p class="hero-disciplines label">
        {featured.data.disciplines.map((d, i) => (
          <>
            {i > 0 && <span class="hero-disciplines-sep">·</span>}
            <span class="hero-discipline">{disciplineLabel(d)}</span>
          </>
        ))}
      </p>
      <p class="hero-client label">{featured.data.client}</p>
    </div>
  </section>

  <section class="news max-w-[1400px] mx-auto px-6 md:px-12 mt-24 md:mt-32 pb-16">
    <header class="news-header">
      <h2 class="display-m">News<span style="color: var(--fg-dim);">.</span></h2>
      <a href="/work" class="label news-view-all">View all <span aria-hidden="true">→</span></a>
    </header>
    <ol class="news-feed">
      {projects.slice(0, 20).map((p) => (
        <NewsItem
          date={p.data.publishedAt}
          title={p.data.title}
          discipline={primaryDisciplineLabel(p.data.primaryDiscipline)}
          href={`/work/${p.id}`}
        />
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero-label {
    color: var(--fg-muted);
    margin-bottom: 1.25rem;
  }
  .hero-title {
    /* display-xl already provides font size + line-height + tracking */
    margin: 0;
  }
  .hero-still {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-raised);
  }
  .hero-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-disciplines {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .hero-discipline {
    color: var(--accent);
  }
  .hero-disciplines-sep {
    color: var(--fg-dim);
  }
  .hero-client {
    color: var(--fg);
    letter-spacing: 0.14em;
  }
  .news-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .news-view-all {
    color: var(--fg-muted);
    transition: color 150ms ease-out;
  }
  .news-view-all:hover,
  .news-view-all:focus-visible {
    color: var(--fg);
  }
  .news-feed {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
