---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import MetaLine from '../../components/MetaLine.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import CreditsBlock from '../../components/CreditsBlock.astro';
import { disciplineLabel } from '../../lib/projects';

import Chapter from '../../components/mdx/Chapter.astro';
import MoodBoard from '../../components/mdx/MoodBoard.astro';
import Storyboard from '../../components/mdx/Storyboard.astro';
import ShotList from '../../components/mdx/ShotList.astro';
import SplitBlock from '../../components/mdx/SplitBlock.astro';
import BtsGrid from '../../components/mdx/BtsGrid.astro';
import PhotoGrid from '../../components/mdx/PhotoGrid.astro';

// Makes <Chapter>, <MoodBoard>, etc. available inside MDX bodies without
// requiring the MDX author to import them — brief Step 6, sub-step 3.
// Components referenced from an MDX body must be imported here, not only in the
// MDX file: Astro only bundles the scoped <style> of components the page itself
// imports, so an MDX-only import renders unstyled.
const mdxComponents = {
  Chapter,
  MoodBoard,
  Storyboard,
  ShotList,
  SplitBlock,
  BtsGrid,
  PhotoGrid,
  VideoEmbed,
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isCaseStudy = project.data.type === 'case-study';

const shootDetailParts = (() => {
  const sd = project.data.shootDetails;
  if (!sd) return [] as string[];
  const parts: string[] = [];
  if (sd.days) parts.push(`${sd.days} day${sd.days === 1 ? '' : 's'}`);
  if (sd.locations) parts.push(`${sd.locations} location${sd.locations === 1 ? '' : 's'}`);
  if (sd.city) parts.push(sd.city);
  if (sd.format) parts.push(sd.format);
  return parts;
})();
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  image={project.data.thumbnail.src}
>
  <article class:list={['project', { 'is-case-study': isCaseStudy }]}>
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <BackLink />
    </div>

    {isCaseStudy ? (
      <>
        <header class="case-header max-w-[1400px] mx-auto px-6 md:px-12">
          <p class="case-label label">
            Case study <span class="case-label-sep">—</span> {project.data.client}, {project.data.year}
          </p>
          <h1 class="display-xl case-title">
            {project.data.title}<span style="color: var(--fg-dim);">.</span>
          </h1>
          <p class="case-summary">{project.data.summary}</p>
        </header>

        {project.data.heroVideo ? (
          <div class="case-hero max-w-[1400px] mx-auto px-6 md:px-12">
            <VideoEmbed
              url={project.data.heroVideo.url}
              mode="loop-muted"
              poster={project.data.heroVideo.poster}
              title={project.data.title}
            />
          </div>
        ) : project.data.heroImage ? (
          <div class="case-hero max-w-[1400px] mx-auto px-6 md:px-12">
            <Image
              src={project.data.heroImage}
              alt={project.data.title}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 1400px) 100vw, 1400px"
              class="case-hero-image"
            />
          </div>
        ) : null}

        <div class="case-meta max-w-[1400px] mx-auto px-6 md:px-12">
          <p class="case-roles label">
            {project.data.disciplines.map((d, i) => (
              <>
                {i > 0 && <span class="case-meta-sep">·</span>}
                <span class="case-role">{disciplineLabel(d)}</span>
              </>
            ))}
          </p>
          {shootDetailParts.length > 0 && (
            <p class="case-shoot label">
              {shootDetailParts.map((p, i) => (
                <>
                  {i > 0 && <span class="case-meta-sep">·</span>}
                  <span>{p}</span>
                </>
              ))}
            </p>
          )}
        </div>

        <div class="case-body max-w-[1400px] mx-auto px-6 md:px-12">
          <Content components={mdxComponents} />
        </div>

        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
          <CreditsBlock credits={project.data.credits} />
        </div>
      </>
    ) : (
      <>
        <header class="project-header max-w-[1400px] mx-auto px-6 md:px-12">
          <MetaLine
            client={project.data.client}
            year={project.data.year}
            disciplines={project.data.disciplines}
          />
          <h1 class="display-l project-title">
            {project.data.title}<span style="color: var(--fg-dim);">.</span>
          </h1>
          <p class="project-summary">{project.data.summary}</p>
        </header>

        {project.data.heroVideo ? (
          <div class="project-hero max-w-[1400px] mx-auto px-6 md:px-12">
            <VideoEmbed
              url={project.data.heroVideo.url}
              mode="interactive"
              poster={project.data.heroVideo.poster}
              title={project.data.title}
            />
          </div>
        ) : project.data.heroImage ? (
          <div class="project-hero max-w-[1400px] mx-auto px-6 md:px-12">
            <Image
              src={project.data.heroImage}
              alt={project.data.title}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 1400px) 100vw, 1400px"
              class="hero-image"
            />
          </div>
        ) : null}

        <div class="project-body prose max-w-[1400px] mx-auto px-6 md:px-12">
          <Content components={mdxComponents} />
        </div>

        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
          <CreditsBlock credits={project.data.credits} />
        </div>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: 1rem 4rem;
  }
  /* Standard project styles */
  .project-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 2.5rem 0;
  }
  .project-title {
    margin: 0;
  }
  .project-summary {
    color: var(--fg-muted);
    max-width: 420px;
    margin: 0;
  }
  .project-hero {
    margin-bottom: 3rem;
  }
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-raised);
  }
  .project-body {
    max-width: 68ch;
    padding-block: 1rem 2rem;
    /* center inside the outer container */
    margin-left: auto;
    margin-right: auto;
  }
  .project-body :global(p) {
    margin-block: 0 1.25rem;
    color: var(--fg);
  }
  .project-body :global(p:last-child) {
    margin-bottom: 0;
  }
  /* Text keeps its 68ch measure, but media breaks out to match the width of
     the hero above it — so a multi-spot film reads as one set, and a photo
     gallery gets the full grid instead of a single column. */
  .project-body :global(.video-embed),
  .project-body :global(.photo-grid) {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: min(1400px - 3rem, 100vw - 3rem);
    margin-block: 2.5rem;
  }
  .project-body :global(.video-embed:last-child),
  .project-body :global(.photo-grid:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 768px) {
    .project-body :global(.video-embed),
    .project-body :global(.photo-grid) {
      width: min(1400px - 6rem, 100vw - 6rem);
    }
  }
  /* Section headings inside a photo gallery sit with the text measure. */
  .project-body :global(h2) {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-block: 3rem 0;
  }
  .project-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-line);
    transition: border-color 150ms ease-out;
  }
  .project-body :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  /* Case study styles */
  .case-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 2rem 0 2.5rem;
  }
  .case-label {
    color: var(--fg-muted);
    margin: 0;
  }
  .case-label-sep {
    color: var(--fg-dim);
    margin: 0 0.25rem;
  }
  .case-title {
    margin: 0;
  }
  .case-summary {
    color: var(--fg-muted);
    max-width: 420px;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .case-hero {
    margin-bottom: 1.5rem;
  }
  .case-hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-raised);
  }
  .case-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .case-roles {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .case-role {
    color: var(--accent);
  }
  .case-shoot {
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin: 0;
    text-align: right;
  }
  .case-meta-sep {
    color: var(--fg-dim);
  }
  .case-body {
    /* Chapters provide their own max-width so allow body to be full container width. */
    padding-block: 1rem 2rem;
  }
</style>
