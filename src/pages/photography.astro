---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';

// Images are named <category>-<source-name>.jpg, so the category comes from the
// filename rather than a hand-maintained list.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../images/photography/*.jpg',
  { eager: true },
);

const CATEGORIES = [
  { key: 'portrait', label: 'Portraits' },
  { key: 'editorial', label: 'Editorial' },
  { key: 'architectural', label: 'Architectural' },
  { key: 'product', label: 'Product' },
] as const;

const photos = await Promise.all(
  Object.entries(files)
    .map(([path, mod]) => {
      const name = path.split('/').pop() ?? '';
      return { cat: name.split('-')[0], img: mod.default, name };
    })
    .filter((p) => CATEGORIES.some((c) => c.key === p.cat))
    .sort((a, b) => a.name.localeCompare(b.name))
    // A single large rendition per photo, used only by the lightbox.
    .map(async (p) => ({
      ...p,
      full: (await getImage({ src: p.img, width: Math.min(p.img.width, 2200), format: 'webp' })).src,
    })),
);

---

<BaseLayout
  title="Photos"
  description="Portraits, editorial and documentary stills, and studio product photography."
>
  <section class="max-w-[1400px] mx-auto px-6 md:px-12">
    <header class="section-header">
      <h1 class="display-l">Photos<span style="color: var(--fg-dim);">.</span></h1>
      <nav class="filter-pills" aria-label="Filter photographs by category">
        <button class="filter-pill label is-active" type="button" data-cat="all" aria-pressed="true">
          All
        </button>
        {CATEGORIES.map((c) => (
          <button class="filter-pill label" type="button" data-cat={c.key} aria-pressed="false">
            {c.label}
          </button>
        ))}
      </nav>
    </header>

    <div class="photo-grid" data-cat-filter="all">
      {photos.map(({ img, cat, full }) => (
        <div class="photo-cell" data-cat={cat} data-full={full} role="button" tabindex="0">
          <Image
            src={img}
            alt=""
            loading="lazy"
            widths={[400, 800, 1200, 1600]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            style={`aspect-ratio: ${img.width} / ${img.height};`}
            class="photo-image"
          />
        </div>
      ))}
    </div>

    <p class="grid-empty label" hidden aria-live="polite">No photographs in this category.</p>
  </section>
  <Lightbox />
</BaseLayout>

<script>
  const bind = () => {
    const grid = document.querySelector<HTMLElement>('.photo-grid');
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const empty = document.querySelector<HTMLElement>('.grid-empty');
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = 'true';

    const apply = (cat: string) => {
      grid.dataset.catFilter = cat;
      pills.forEach((p) => {
        const on = p.dataset.cat === cat;
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-pressed', String(on));
      });
      if (empty) {
        const n = grid.querySelectorAll(
          cat === 'all' ? '.photo-cell' : `.photo-cell[data-cat="${cat}"]`,
        ).length;
        empty.hidden = n > 0;
      }
    };

    pills.forEach((p) => p.addEventListener('click', () => apply(p.dataset.cat ?? 'all')));
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .filter-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-pill {
    padding: 0.5rem 0.875rem;
    border: 1px solid transparent;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .filter-pill:hover,
  .filter-pill:focus-visible {
    color: var(--fg);
  }
  .filter-pill.is-active {
    border-color: var(--accent);
    color: var(--fg);
  }

  .photo-grid {
    columns: 3;
    column-gap: 0.75rem;
  }
  .photo-cell {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    background: var(--bg-raised);
    overflow: hidden;
  }
  .photo-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .photo-grid[data-cat-filter='portrait'] .photo-cell:not([data-cat='portrait']),
  .photo-grid[data-cat-filter='editorial'] .photo-cell:not([data-cat='editorial']),
  .photo-grid[data-cat-filter='architectural'] .photo-cell:not([data-cat='architectural']),
  .photo-grid[data-cat-filter='product'] .photo-cell:not([data-cat='product']) {
    display: none;
  }

  .grid-empty {
    margin-top: 3rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1024px) {
    .photo-grid {
      columns: 2;
    }
  }
  @media (max-width: 640px) {
    .photo-grid {
      columns: 1;
      column-gap: 0.5rem;
    }
    .photo-cell {
      margin-bottom: 0.5rem;
    }
  }
</style>
