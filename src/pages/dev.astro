---
import BaseLayout from '../layouts/BaseLayout.astro';

// The consulting site is a separate app on its own subdomain; this page is the
// portfolio's summary of that work, not a copy of it.
const CONSULTING_URL = 'https://dev.royheisler.com';

const services = [
  {
    title: 'SaaS audit',
    body: "A review of your monthly software spend to find the bloat. Most teams are paying for features they'll never use.",
    tags: ['Cost analysis', 'Vendor review', 'ROI assessment'],
  },
  {
    title: 'Legacy migration',
    body: 'The Access database from 2008, the spreadsheet with 47 tabs — moved to modern, web-based tools your team will actually use.',
    tags: ['Data migration', 'Excel to web', 'Access replacement'],
  },
  {
    title: 'Custom dashboards',
    body: 'The dashboard you need, with the metrics you care about and nothing else, deployed on your own infrastructure.',
    tags: ['Real-time data', 'Self-hosted', 'Your design'],
  },
];

const products = [
  {
    name: 'GearBase',
    url: 'https://mygearbase.com',
    summary:
      'A production inventory system handling thousands of items with real-time search, built for insurance-grade tracking.',
    notes: ['Real-time sync', 'Offline capable', 'Sub-100ms search'],
  },
  {
    name: 'AdBase Studio',
    url: 'https://adbasestudio.com',
    summary:
      'Video asset management for advertising agencies — AI metadata, broadcast tracking, and client portals in one place.',
    notes: ['AI metadata', 'Broadcast tracking', 'Vimeo + Dropbox'],
  },
];
---

<BaseLayout
  title="Dev"
  description="Custom internal tools and software consulting — SaaS audits, legacy migration, and dashboards for operations teams."
>
  <section class="dev-page max-w-[1400px] mx-auto px-6 md:px-12">
    <header class="dev-header">
      <p class="label dev-label">Software</p>
      <h1 class="display-l dev-headline">
        I build the exact tools you need to run your business<span style="color: var(--fg-dim);">.</span>
      </h1>
      <p class="dev-intro">
        The same attention that goes into a frame goes into a system. I work with
        operations teams who are renting software they don't use, and replace it
        with something built for how they actually work.
      </p>
    </header>

    <div class="dev-services">
      {services.map((s) => (
        <article class="dev-service">
          <h2 class="dev-service-title">{s.title}</h2>
          <p class="dev-service-body">{s.body}</p>
          <ul class="dev-tags">
            {s.tags.map((t) => <li class="dev-tag label">{t}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="dev-products">
      <h2 class="dev-section-label label">Production apps</h2>
      {products.map((p) => (
        <article class="dev-product">
          <div class="dev-product-head">
            <h3 class="dev-product-name">{p.name}</h3>
            <a href={p.url} class="dev-product-url label" rel="noopener" target="_blank">
              {p.url.replace('https://', '')} <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
          <p class="dev-product-summary">{p.summary}</p>
          <ul class="dev-tags">
            {p.notes.map((n) => <li class="dev-tag label">{n}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="dev-footer">
      <a href={CONSULTING_URL} class="dev-cta" rel="noopener">
        <span>The full consulting site</span>
        <span aria-hidden="true" class="dev-cta-arrow">&rarr;</span>
      </a>
      <p class="dev-footer-note label">
        Case studies, the audit offer, and how to book time.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .dev-page {
    padding-block: 1rem 4rem;
  }
  .dev-header {
    margin: 2.5rem 0 4.5rem;
  }
  .dev-label {
    color: var(--fg-muted);
    margin: 0 0 1.25rem;
  }
  .dev-headline {
    margin: 0;
    max-width: 18ch;
  }
  .dev-intro {
    margin: 1.75rem 0 0;
    max-width: 520px;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .dev-services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 4.5rem;
    border-bottom: 1px solid var(--rule, rgba(242, 237, 228, 0.12));
  }
  .dev-service-title {
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 0.85rem;
    color: var(--fg);
  }
  .dev-service-body {
    margin: 0 0 1.25rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .dev-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dev-tag {
    color: var(--fg-dim);
    border: 1px solid var(--rule, rgba(242, 237, 228, 0.12));
    padding: 0.3rem 0.6rem;
  }

  .dev-products {
    padding-block: 4rem;
  }
  .dev-section-label {
    color: var(--fg-muted);
    margin: 0 0 2.25rem;
  }
  .dev-product {
    padding-block: 2rem;
    border-top: 1px solid var(--rule, rgba(242, 237, 228, 0.12));
  }
  .dev-product-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .dev-product-name {
    font-size: 24px;
    font-weight: 500;
    margin: 0;
  }
  .dev-product-url {
    color: var(--accent);
    transition: opacity 150ms ease-out;
  }
  .dev-product-url:hover {
    opacity: 0.75;
  }
  .dev-product-summary {
    margin: 0.85rem 0 1.25rem;
    max-width: 620px;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .dev-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-top: 2rem;
  }
  .dev-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--fg);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.5rem;
    transition: color 200ms ease-out;
  }
  .dev-cta:hover,
  .dev-cta:focus-visible {
    color: var(--accent);
  }
  .dev-cta-arrow {
    color: var(--accent);
    transition: transform 200ms ease-out;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dev-cta:hover .dev-cta-arrow {
      transform: translateX(0.25rem);
    }
  }
  .dev-footer-note {
    color: var(--fg-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .dev-services {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
