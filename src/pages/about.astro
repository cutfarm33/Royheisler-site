---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('about', 'about');
if (!about) throw new Error('src/content/about.mdx is required for /about');

const { Content } = await render(about);
const { headline, portrait, services, clients, press, representation, stills } = about.data;
---

<BaseLayout title="About" description={headline}>
  <section class="about-page max-w-[1400px] mx-auto px-6 md:px-12">
    <header class="about-headline-wrap">
      <h1 class="display-l about-headline">{headline}</h1>
    </header>

    <div class="about-intro">
      <div class="about-bio">
        <Content />
      </div>
      {portrait && (
        <Image
          src={portrait}
          alt="Roy Heisler"
          widths={[400, 700, 1400]}
          sizes="(max-width: 900px) 100vw, 420px"
          loading="eager"
          class="about-portrait"
        />
      )}
    </div>

    {stills.length > 0 && (
      <div class="about-stills">
        {stills.map((img) => (
          <Image
            src={img}
            alt=""
            widths={[400, 800]}
            sizes="(max-width: 640px) 50vw, 25vw"
            loading="lazy"
            class="about-still"
          />
        ))}
      </div>
    )}

    <div class="about-columns">
      <section class="about-section">
        <h2 class="about-section-label label">Services</h2>
        <ul class="about-list">
          {services.map((s) => (
            <li class="about-list-item">{s}</li>
          ))}
        </ul>
      </section>

      {clients.length > 0 && (
        <section class="about-section">
          <h2 class="about-section-label label">Selected clients</h2>
          <ul class="about-list">
            {clients.map((c) => (
              <li class="about-list-item">{c}</li>
            ))}
          </ul>
        </section>
      )}

      {press.length > 0 && (
        <section class="about-section">
          <h2 class="about-section-label label">Press</h2>
          <ul class="about-list">
            {press.map((p) => (
              <li class="about-list-item">
                <a href={p.url} class="about-press-link" rel="noopener">
                  {p.outlet} <span aria-hidden="true">&nearr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {representation && (
      <p class="about-representation label">{representation}</p>
    )}
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: 1rem 4rem;
  }
  .about-headline-wrap {
    margin: 2rem 0 3rem;
    max-width: 900px;
  }
  .about-headline {
    margin: 0;
  }
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 600px) 420px;
    gap: 4rem;
    align-items: start;
    margin-bottom: 4rem;
  }
  .about-bio {
    max-width: 600px;
  }
  .about-portrait {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 900px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .about-portrait {
      max-width: 420px;
    }
  }
  .about-bio :global(p) {
    font-size: 16px;
    line-height: 1.7;
    margin-block: 0 1.25rem;
  }
  .about-bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .about-bio :global(a) {
    color: var(--accent);
    border-bottom: 1px solid rgba(201, 162, 39, 0.35);
    transition: border-color 150ms ease-out;
  }
  .about-bio :global(a:hover) {
    border-bottom-color: var(--accent);
  }
  .about-stills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 768px) {
    .about-stills {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .about-still {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: var(--bg-raised);
  }
  .about-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .about-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  .about-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about-section-label {
    color: var(--fg-muted);
    margin: 0;
  }
  .about-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .about-list-item {
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg);
  }
  .about-press-link {
    color: var(--fg);
    transition: color 150ms ease-out;
  }
  .about-press-link:hover,
  .about-press-link:focus-visible {
    color: var(--accent);
  }
  .about-representation {
    color: var(--fg-muted);
    max-width: 600px;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    margin: 0;
  }
</style>
