---
interface Props {
  discipline: 'FILM' | 'PHOTO' | 'CODE';
}
const { discipline } = Astro.props;
const isFilm = discipline === 'FILM';
---

<span class:list={['discipline-tag', { 'is-film': isFilm }]}>{discipline}</span>

<style>
  .discipline-tag {
    display: inline-block;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    font-weight: 500;
    padding: 3px 8px;
    background: var(--tag-bg);
    color: var(--fg-muted);
  }
  .discipline-tag.is-film {
    background: var(--accent-bg);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .discipline-tag {
      font-size: 10px;
      padding: 3px 7px;
    }
  }
</style>
