---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  caption?: string;
}
const { images, caption } = Astro.props;
---

<figure class="bts-grid">
  <div class="grid">
    {images.map((img) => (
      <div class="bts-cell">
        <Image src={img} alt="" loading="lazy" class="w-full h-full object-cover" />
      </div>
    ))}
  </div>
  {caption && <figcaption class="label" style="color: var(--fg-muted); margin-top: 1rem;">{caption}</figcaption>}
</figure>

<style>
  .bts-grid {
    margin-block: 2.5rem;
  }
  .grid {
    /* 2fr 1fr 1fr uneven rhythm per brief Section 7 (BtsGrid spec). */
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-auto-rows: 180px;
    gap: 0.5rem;
  }
  .bts-cell {
    overflow: hidden;
  }
  .bts-cell:first-child {
    grid-row: span 2;
    grid-column: span 1;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 140px;
    }
    .bts-cell:first-child {
      grid-row: auto;
      grid-column: span 2;
    }
  }
</style>
