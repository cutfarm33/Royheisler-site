---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  caption?: string;
  /** 'natural' keeps each frame's own ratio; 'uniform' crops to a shared 3:2. */
  fit?: 'natural' | 'uniform';
}
const { images, caption, fit = 'natural' } = Astro.props;

// Wide frames earn two columns so panoramas don't sit as letterboxed slivers
// next to a square. Ratio thresholds, not hardcoded per-image classes.
const spanOf = (img: ImageMetadata) => {
  const r = img.width / img.height;
  if (fit === 'uniform') return 'span-1';
  return r >= 2.1 ? 'span-2' : 'span-1';
};
---

<figure class:list={['photo-grid', `fit-${fit}`]}>
  <div class="photo-grid-inner">
    {images.map((img) => (
      <div class:list={['photo-cell', spanOf(img)]}>
        <Image
          src={img}
          alt=""
          loading="lazy"
          widths={[400, 800, 1200, 1600]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          style={fit === 'natural' ? `aspect-ratio: ${img.width} / ${img.height};` : undefined}
          class="photo-image"
        />
      </div>
    ))}
  </div>
  {caption && <figcaption class="photo-caption label">{caption}</figcaption>}
</figure>

<style>
  .photo-grid {
    margin-block: 2.5rem 3rem;
  }
  .photo-grid-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .photo-cell {
    background: var(--bg-raised);
    overflow: hidden;
  }
  .span-2 {
    grid-column: span 2;
  }
  .photo-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .fit-uniform .photo-image {
    aspect-ratio: 3 / 2;
  }
  .photo-caption {
    margin-top: 1rem;
    color: var(--fg-muted);
  }
  @media (max-width: 1024px) {
    .photo-grid-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .photo-grid-inner {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .span-2 {
      grid-column: span 1;
    }
  }
</style>
