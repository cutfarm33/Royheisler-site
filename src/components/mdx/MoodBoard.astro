---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  caption?: string;
}
const { images, caption } = Astro.props;
---

<figure class="mood-board">
  <div class="mood-grid">
    {images.map((img) => (
      <Image
        src={img}
        alt=""
        loading="lazy"
        widths={[300, 600]}
        sizes="(max-width: 640px) 50vw, 25vw"
        class="mood-image"
      />
    ))}
  </div>
  {caption && <figcaption class="mood-caption label">{caption}</figcaption>}
</figure>

<style>
  .mood-board {
    margin-block: 2.5rem 3rem;
  }
  .mood-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .mood-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .mood-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .mood-caption {
    color: var(--fg-muted);
    margin-top: 1rem;
  }
</style>
