---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  caption?: string;
}
const { images, caption } = Astro.props;
---

<figure class="mood-board">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
    {images.map((img) => (
      <Image src={img} alt="" loading="lazy" class="w-full h-auto" />
    ))}
  </div>
  {caption && <figcaption class="label" style="color: var(--fg-muted); margin-top: 1rem;">{caption}</figcaption>}
</figure>

<style>
  .mood-board {
    margin-block: 2.5rem;
  }
</style>
