---
// Renders children side-by-side on desktop, stacked on mobile.
// Typical use: <SplitBlock><Storyboard /><ShotList /></SplitBlock>
---

<div class="split-block">
  <slot />
</div>

<style>
  .split-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-block: 2.5rem 3rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .split-block {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
