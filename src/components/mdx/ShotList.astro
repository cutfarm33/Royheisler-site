---
interface Shot {
  id: string;
  description: string;
  lens?: string;
}

interface Props {
  label?: string;
  shots: Shot[];
}
const { label, shots } = Astro.props;
---

<figure class="shot-list">
  {label && <figcaption class="shot-list-label label">{label}</figcaption>}
  <table class="shot-table">
    <tbody>
      {shots.map((s) => (
        <tr>
          <td class="shot-id">{s.id}</td>
          <td class="shot-desc">{s.description}</td>
          {s.lens && <td class="shot-lens">{s.lens}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</figure>

<style>
  .shot-list {
    margin: 0;
  }
  .shot-list-label {
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }
  .shot-table {
    width: 100%;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.5;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }
  .shot-table tr {
    border-bottom: 1px solid var(--border);
  }
  .shot-table td {
    padding: 0.625rem 0.5rem;
    vertical-align: top;
  }
  .shot-id {
    color: var(--fg-muted);
    width: 3.5rem;
    white-space: nowrap;
  }
  .shot-desc {
    color: var(--fg);
  }
  .shot-lens {
    color: var(--accent);
    text-align: right;
    white-space: nowrap;
    width: 5rem;
  }
  @media (max-width: 480px) {
    .shot-table {
      font-size: 12px;
    }
    .shot-id {
      width: 3rem;
    }
  }
</style>
