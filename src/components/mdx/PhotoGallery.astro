---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Group {
  key: string;
  label: string;
  images: ImageMetadata[];
}
interface Props {
  groups: Group[];
}
const { groups } = Astro.props;

const all = groups.flatMap((g) => g.images.map((img) => ({ img, key: g.key })));

// Wide frames earn two columns so panoramas don't sit as letterboxed slivers.
const spanOf = (img: ImageMetadata) => (img.width / img.height >= 2.1 ? 'span-2' : 'span-1');
---

<div class="photo-gallery" data-photo-filter="all">
  <nav class="pg-filters" aria-label="Filter photographs by category">
    <button class="pg-pill label is-active" type="button" data-cat="all" aria-pressed="true">All</button>
    {groups.map((g) => (
      <button class="pg-pill label" type="button" data-cat={g.key} aria-pressed="false">
        {g.label}
      </button>
    ))}
  </nav>

  <div class="pg-grid">
    {all.map(({ img, key }) => (
      <div class:list={['pg-cell', spanOf(img)]} data-cat={key}>
        <Image
          src={img}
          alt=""
          loading="lazy"
          widths={[400, 800, 1200, 1600]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          style={`aspect-ratio: ${img.width} / ${img.height};`}
          class="pg-image"
        />
      </div>
    ))}
  </div>

  <p class="pg-empty label" hidden>No photographs in this category.</p>
</div>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLElement>('.photo-gallery:not([data-bound])').forEach((root) => {
      root.dataset.bound = 'true';
      const pills = root.querySelectorAll<HTMLButtonElement>('.pg-pill');
      const empty = root.querySelector<HTMLElement>('.pg-empty');

      const apply = (cat: string) => {
        root.dataset.photoFilter = cat;
        pills.forEach((p) => {
          const on = p.dataset.cat === cat;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', String(on));
        });
        if (empty) {
          const visible = root.querySelectorAll(
            cat === 'all' ? '.pg-cell' : `.pg-cell[data-cat="${cat}"]`,
          ).length;
          empty.hidden = visible > 0;
        }
      };

      pills.forEach((p) =>
        p.addEventListener('click', () => apply(p.dataset.cat ?? 'all')),
      );
    });
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .photo-gallery {
    margin-block: 2rem 3rem;
  }
  .pg-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .pg-pill {
    padding: 0.5rem 0.875rem;
    border: 1px solid transparent;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .pg-pill:hover,
  .pg-pill:focus-visible {
    color: var(--fg);
  }
  .pg-pill.is-active {
    border-color: var(--accent);
    color: var(--fg);
  }

  .pg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .pg-cell {
    background: var(--bg-raised);
    overflow: hidden;
  }
  .span-2 {
    grid-column: span 2;
  }
  .pg-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Filtering. The cells are rendered by this same component, so no :global()
     is needed here — unlike the work grid, whose tiles come from ProjectTile. */
  .photo-gallery[data-photo-filter='portrait'] .pg-cell:not([data-cat='portrait']),
  .photo-gallery[data-photo-filter='editorial'] .pg-cell:not([data-cat='editorial']),
  .photo-gallery[data-photo-filter='product'] .pg-cell:not([data-cat='product']) {
    display: none;
  }

  .pg-empty {
    margin-top: 2rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1024px) {
    .pg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .pg-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .span-2 {
      grid-column: span 1;
    }
  }
</style>
