---
interface Props {
  number: string;
  label: string;
}
const { number, label } = Astro.props;
---

<section class="chapter">
  <header class="chapter-header">
    <span class="chapter-number">{number}</span>
    <h2 class="chapter-label">{label}</h2>
  </header>
  <div class="chapter-body">
    <slot />
  </div>
</section>

<style>
  .chapter {
    padding-block: 4rem 2rem;
    scroll-margin-top: 6rem;
  }
  .chapter + .chapter {
    border-top: 1px solid var(--border);
  }
  .chapter-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2rem;
    max-width: 68ch;
  }
  .chapter-number {
    font-family: var(--font-display);
    font-size: 42px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .chapter-label {
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--fg);
    font-weight: 500;
    margin: 0;
  }
  .chapter-body {
    max-width: 68ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg);
  }
  .chapter-body :global(p) {
    margin-block: 0 1.25rem;
  }
  .chapter-body :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 640px) {
    .chapter-header {
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .chapter-number {
      font-size: 32px;
    }
    .chapter-label {
      font-size: 18px;
    }
  }
</style>
