---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50" transition:persist>
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 h-16 flex items-center justify-between">
    <a href="/" class="wordmark" aria-label="Roy Heisler, home">Roy Heisler</a>
    <div class="nav-right">
      <div id="nav-links" class="nav-links">
        <a href="/" class:list={['label nav-link', { 'is-active': isActive('/') }]}>Video</a>
        <a href="/photography" class:list={['label nav-link', { 'is-active': isActive('/photography') }]}>Photos</a>
        <a href="/graphics" class:list={['label nav-link', { 'is-active': isActive('/graphics') }]}>Graphics</a>
        <a href="/about" class:list={['label nav-link', { 'is-active': isActive('/about') }]}>About</a>
        <a href="/contact" class:list={['label nav-link', { 'is-active': isActive('/contact') }]}>Contact</a>
      </div>

      <button
        id="nav-toggle"
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="sr-only">Menu</span>
        <span class="bar bar-1" aria-hidden="true"></span>
        <span class="bar bar-2" aria-hidden="true"></span>
        <span class="bar bar-3" aria-hidden="true"></span>
      </button>

      <button id="theme-toggle" type="button" class="theme-toggle" aria-pressed="false">
        <span class="sr-only theme-toggle-label">Switch to light mode</span>
        <svg class="theme-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6M5.3 5.3l1.9 1.9M16.8 16.8l1.9 1.9M18.7 5.3l-1.9 1.9M7.2 16.8l-1.9 1.9" />
        </svg>
        <svg class="theme-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const bind = () => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    update();
    window.addEventListener('scroll', update, { passive: true });
  };

  /** Resolve the theme actually in effect, whether it came from a stored
   *  choice or from the OS. */
  const currentTheme = () =>
    document.documentElement.dataset.theme ??
    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

  const syncToggle = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const isLight = currentTheme() === 'light';
    btn.setAttribute('aria-pressed', String(isLight));
    const label = btn.querySelector('.theme-toggle-label');
    if (label) label.textContent = isLight ? 'Switch to dark mode' : 'Switch to light mode';
  };

  const bindToggle = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    btn.addEventListener('click', () => {
      const next = currentTheme() === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage unavailable, the choice just won't persist */
      }
      syncToggle();
    });
    syncToggle();
  };

  // Follow the OS if the visitor has never made an explicit choice.
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (!document.documentElement.dataset.theme) syncToggle();
  });

  const bindMenu = () => {
    const btn = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav || btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    const close = () => {
      nav.classList.remove('menu-open');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.removeProperty('overflow');
    };
    const open = () => {
      nav.classList.add('menu-open');
      btn.setAttribute('aria-expanded', 'true');
      // Stop the page scrolling behind the panel.
      document.body.style.overflow = 'hidden';
    };

    btn.addEventListener('click', () =>
      nav.classList.contains('menu-open') ? close() : open(),
    );
    // Tapping a link should dismiss it, with ClientRouter the page swaps
    // without a reload, so the panel would otherwise stay open.
    document.getElementById('nav-links')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    // Leaving mobile width while open would strand the locked scroll.
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  };

  /**
   * The nav is transition:persist, so it survives view-transition navigations
   * intact, including the is-active classes rendered on the *first* page it
   * was served with. They have to be recomputed from the current URL, using the
   * same rule as the server: exact match, or a section prefix.
   */
  const syncActive = () => {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('#nav-links a').forEach((a) => {
      const href = (a.getAttribute('href') ?? '').replace(/\/+$/, '') || '/';
      const active =
        href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
      a.classList.toggle('is-active', active);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };

  bind();
  bindToggle();
  bindMenu();
  syncActive();
  document.addEventListener('astro:page-load', () => {
    bind();
    bindToggle();
    bindMenu();
    syncActive();
    document.body.style.removeProperty('overflow');
  });
</script>

<style>
  nav {
    /* Lifted above the page: white on the warm paper background in light,
       a clear step up from near-black in dark. The hairline underneath keeps
       the edge crisp where the contrast is slight. */
    background: var(--nav-bg);
    border-bottom: 1px solid var(--border);
    transition: background-color 200ms ease, backdrop-filter 200ms ease,
      border-color 200ms ease;
  }
  nav.is-scrolled {
    background: var(--scrim-nav);
    border-bottom-color: var(--border-strong);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Hamburger, hidden on desktop, where the links show inline. */
  .nav-toggle {
    display: none;
    position: relative;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: border-color 150ms ease-out;
  }
  .nav-toggle:hover,
  .nav-toggle:focus-visible {
    border-color: var(--border-strong);
  }
  .bar {
    position: absolute;
    left: 7px;
    width: 18px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 200ms ease, opacity 150ms ease;
  }
  .bar-1 { top: 11px; }
  .bar-2 { top: 15.5px; }
  .bar-3 { top: 20px; }

  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }
    .nav-right {
      gap: 0.5rem;
    }
    /* Full-height panel rather than a dropdown, the nav is fixed, so a
       dropdown would sit over content and scroll away with it. */
    .nav-links {
      position: fixed;
      inset: 4rem 0 0 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0;
      padding: 1.5rem;
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition: opacity 200ms ease, transform 200ms ease, visibility 200ms;
      overflow-y: auto;
    }
    :global(nav.menu-open) .nav-links {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .nav-links > a {
      width: 100%;
      padding-block: 1rem;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    :global(nav.menu-open) .bar-1 {
      transform: translateY(4.5px) rotate(45deg);
    }
    :global(nav.menu-open) .bar-2 {
      opacity: 0;
    }
    :global(nav.menu-open) .bar-3 {
      transform: translateY(-4.5px) rotate(-45deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .bar {
      transition: none;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .theme-icon {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    grid-area: 1 / 1;
  }
  /* Show the icon for the theme you'd switch *to*. */
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(:root[data-theme='light']) .icon-sun { display: block; }
  :global(:root[data-theme='light']) .icon-moon { display: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .icon-sun { display: block; }
    :global(:root:not([data-theme='dark'])) .icon-moon { display: none; }
    :global(:root[data-theme='dark']) .icon-sun { display: none; }
    :global(:root[data-theme='dark']) .icon-moon { display: block; }
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .wordmark {
      font-size: 20px;
    }
  }
  .nav-link {
    color: var(--fg-muted);
    transition: color 150ms ease-out;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--fg);
  }
  .nav-reel {
    color: var(--accent);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    transition: opacity 150ms ease-out;
  }
  .nav-reel:hover {
    opacity: 0.75;
  }
  @media (max-width: 640px) {
    .nav-link {
      font-size: 10px;
    }
    .nav-reel {
      font-size: 10px;
    }
  }
</style>
