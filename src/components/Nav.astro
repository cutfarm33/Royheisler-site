---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50" transition:persist>
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 h-16 flex items-center justify-between">
    <a href="/" class="wordmark" aria-label="Roy Heisler — home">Roy</a>
    <div class="flex items-center gap-5 md:gap-8">
      <a href="/" class:list={['label nav-link', { 'is-active': isActive('/') }]}>News</a>
      <a href="/work" class:list={['label nav-link', { 'is-active': isActive('/work') }]}>Work</a>
      <a href="/dev" class:list={['label nav-link', { 'is-active': isActive('/dev') }]}>Dev</a>
      <a href="/about" class:list={['label nav-link', { 'is-active': isActive('/about') }]}>About</a>
      <a href="/contact" class:list={['label nav-link', { 'is-active': isActive('/contact') }]}>Contact</a>
      <a href="/reel" class:list={['label nav-reel', { 'is-active': isActive('/reel') }]}>Reel</a>
    </div>
  </div>
</nav>

<script>
  const bind = () => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    update();
    window.addEventListener('scroll', update, { passive: true });
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  nav {
    transition: background-color 200ms ease, backdrop-filter 200ms ease;
  }
  nav.is-scrolled {
    background: rgba(10, 10, 10, 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--fg);
  }
  .nav-link {
    color: var(--fg-muted);
    transition: color 150ms ease-out;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--fg);
  }
  .nav-reel {
    color: var(--accent);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    transition: opacity 150ms ease-out;
  }
  .nav-reel:hover {
    opacity: 0.75;
  }
  @media (max-width: 640px) {
    .nav-link {
      font-size: 10px;
    }
    .nav-reel {
      font-size: 10px;
    }
  }
</style>
