---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t" style="border-color: var(--border);">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
    <a href="mailto:hello@royheisler.com" class="label footer-link">hello@royheisler.com</a>
    <nav aria-label="Site and social" class="flex items-center gap-6">
      <a href="/news" class="label footer-link">News</a>
      <a href="https://www.instagram.com/" class="label footer-link" rel="me noopener">Instagram</a>
      <a href="https://vimeo.com/" class="label footer-link" rel="me noopener">Vimeo</a>
      <a href="https://www.linkedin.com/" class="label footer-link" rel="me noopener">LinkedIn</a>
    </nav>
    <p class="label" style="color: var(--fg-dim);">© {year} Roy Heisler</p>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--fg-muted);
    transition: color 150ms ease-out;
  }
  .footer-link:hover {
    color: var(--fg);
  }
</style>
