---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideoUrl, buildEmbedSrc } from '../lib/video';

interface Props {
  url: string;
  mode?: 'loop-muted' | 'interactive';
  poster?: ImageMetadata;
  aspectRatio?: string;
  title?: string;
}

const {
  url,
  mode = 'interactive',
  poster,
  aspectRatio = '16/9',
  title = 'Video',
} = Astro.props;

const parsed = parseVideoUrl(url);
const embedSrc = buildEmbedSrc(parsed, mode);
const hostLabel = parsed.host === 'vimeo' ? 'Vimeo' : parsed.host === 'youtube' ? 'YouTube' : 'Video';
---

<figure
  class:list={['video-embed', `mode-${mode}`]}
  data-mode={mode}
  data-src={embedSrc}
  data-title={title}
  style={`aspect-ratio: ${aspectRatio};`}
>
  {poster && (
    <Image src={poster} alt="" class="video-poster" loading="eager" />
  )}
  {mode === 'interactive' && embedSrc && (
    <button class="video-play" type="button" aria-label={`Play ${title} on ${hostLabel}`}>
      <span class="play-label">Play</span>
    </button>
  )}
  {!embedSrc && (
    <div class="video-fallback">
      <p class="label">Video unavailable</p>
    </div>
  )}
</figure>

<script>
  const bind = () => {
    const embeds = document.querySelectorAll<HTMLElement>('.video-embed:not([data-bound])');
    if (embeds.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const makeIframe = (src: string, title: string) => {
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = title;
      iframe.loading = 'lazy';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.style.position = 'absolute';
      iframe.style.inset = '0';
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      return iframe;
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const fig = entry.target as HTMLElement;
          const src = fig.dataset.src;
          const mode = fig.dataset.mode;
          const title = fig.dataset.title ?? 'Video';
          if (!src) return obs.unobserve(fig);
          if (mode === 'loop-muted' && !prefersReducedMotion) {
            fig.appendChild(makeIframe(src, title));
          }
          obs.unobserve(fig);
        });
      },
      { rootMargin: '200px' },
    );

    embeds.forEach((fig) => {
      fig.setAttribute('data-bound', 'true');
      observer.observe(fig);

      if (fig.dataset.mode === 'interactive') {
        const btn = fig.querySelector<HTMLButtonElement>('.video-play');
        btn?.addEventListener('click', () => {
          const src = fig.dataset.src;
          const title = fig.dataset.title ?? 'Video';
          if (!src) return;
          const autoSrc = src + (src.includes('?') ? '&' : '?') + 'autoplay=1';
          fig.appendChild(makeIframe(autoSrc, title));
          btn.remove();
        });
      }
    });
  };

  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .video-embed {
    position: relative;
    width: 100%;
    margin: 0;
    background: var(--bg-raised);
    overflow: hidden;
  }
  .video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mode-loop-muted .video-poster {
    /* On loop-muted, iframe will cover the poster once loaded. */
    z-index: 0;
  }
  .video-play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background: rgba(10, 10, 10, 0.12);
    color: var(--fg);
    cursor: pointer;
    border: 0;
    transition: background 150ms ease-out;
  }
  .video-play:hover,
  .video-play:focus-visible {
    background: rgba(10, 10, 10, 0.35);
  }
  .play-label {
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .video-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--fg-muted);
  }
</style>
