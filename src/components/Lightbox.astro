---
// Click-to-enlarge for any page with a .photo-grid of .photo-cell items.
// Uses <dialog> so focus trapping, Escape, and inertness come from the platform.
---

<dialog id="lightbox" class="lightbox" aria-label="Enlarged photograph">
  <button class="lb-close" type="button" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous photograph">
    <span aria-hidden="true">&larr;</span>
  </button>
  <button class="lb-nav lb-next" type="button" aria-label="Next photograph">
    <span aria-hidden="true">&rarr;</span>
  </button>
  <figure class="lb-figure">
    <img class="lb-image" alt="" />
    <figcaption class="lb-count label" aria-live="polite"></figcaption>
  </figure>
</dialog>

<script>
  const bind = () => {
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    const grid = document.querySelector<HTMLElement>('.photo-grid');
    if (!dlg || !grid || dlg.dataset.bound) return;
    dlg.dataset.bound = 'true';

    const img = dlg.querySelector<HTMLImageElement>('.lb-image')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    let index = 0;

    /** Only cells the current filter leaves visible — so arrows stay in-category. */
    const visible = () =>
      [...grid.querySelectorAll<HTMLElement>('.photo-cell')].filter(
        (c) => getComputedStyle(c).display !== 'none',
      );

    const show = (cells: HTMLElement[], i: number) => {
      const cell = cells[i];
      if (!cell) return;
      index = i;
      const full = cell.dataset.full;
      const inner = cell.querySelector('img');
      img.src = full || inner?.currentSrc || inner?.src || '';
      img.alt = inner?.alt || '';
      count.textContent = `${i + 1} / ${cells.length}`;
      // Preload neighbours so arrowing through doesn't flash.
      [i - 1, i + 1].forEach((n) => {
        const c = cells[(n + cells.length) % cells.length];
        const src = c?.dataset.full;
        if (src) new Image().src = src;
      });
    };

    const step = (delta: number) => {
      const cells = visible();
      if (!cells.length) return;
      show(cells, (index + delta + cells.length) % cells.length);
    };

    grid.addEventListener('click', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('.photo-cell');
      if (!cell) return;
      const cells = visible();
      const i = cells.indexOf(cell);
      if (i === -1) return;
      show(cells, i);
      dlg.showModal();
      document.body.style.overflow = 'hidden';
    });

    grid.addEventListener('keydown', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('.photo-cell');
      if (!cell || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      cell.click();
    });

    dlg.querySelector('.lb-close')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      step(-1);
    });
    dlg.querySelector('.lb-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      step(1);
    });

    // Clicking the backdrop (the dialog itself, outside the figure) closes.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });

    // Covers Escape too, which the platform handles without a click.
    dlg.addEventListener('close', () => {
      document.body.style.removeProperty('overflow');
      img.removeAttribute('src');
    });
  };

  bind();
  document.addEventListener('astro:page-load', bind);
  document.addEventListener('astro:before-swap', () => {
    document.body.style.removeProperty('overflow');
  });
</script>

<style>
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(4px);
  }
  .lb-figure {
    margin: 0;
    width: 100vw;
    height: 100vh;
    display: grid;
    place-items: center;
    gap: 1rem;
    grid-template-rows: 1fr auto;
    padding: 3.5rem 1.5rem 2rem;
    box-sizing: border-box;
    pointer-events: none;
  }
  .lb-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    pointer-events: auto;
  }
  .lb-count {
    color: rgba(242, 237, 228, 0.55);
    margin: 0;
  }

  .lb-close,
  .lb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid rgba(242, 237, 228, 0.2);
    color: rgba(242, 237, 228, 0.85);
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }
  .lb-close:hover,
  .lb-nav:hover,
  .lb-close:focus-visible,
  .lb-nav:focus-visible {
    border-color: rgba(242, 237, 228, 0.6);
    color: #f2ede4;
  }
  .lb-close {
    top: 1.25rem;
    right: 1.25rem;
    font-size: 26px;
  }
  .lb-prev {
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .lb-prev { left: 0.5rem; }
    .lb-next { right: 0.5rem; }
    .lb-close { top: 0.75rem; right: 0.75rem; }
    .lb-figure { padding: 3rem 0.75rem 1.5rem; }
  }
</style>
